# Copy this file to .env for local manual testing.
# Never commit the real .env file or production secrets.

DJANGO_SECRET_KEY=django-insecure-local-authkits-test-only
DJANGO_DEBUG=1

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTHKITS_TOTP_KEYS=

# Trusted devices require correctly configured HTTPS. Keep disabled for normal HTTP dev.
AUTHKITS_TRUSTED_DEVICES=0
