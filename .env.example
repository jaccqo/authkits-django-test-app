# Authkits Django reference app — local development example.
# Copy to .env. The real .env is gitignored.
# Never commit real production secrets.

# Django
DJANGO_SECRET_KEY=django-insecure-local-authkits-reference-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local email delivery. Console output keeps verification/reset/MFA codes visible.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=Authkits Example <authkits@localhost>

# Account flow
AUTHKITS_REQUIRE_EMAIL_VERIFICATION=1
AUTHKITS_LOGIN_REDIRECT=/auth/security/
AUTHKITS_EMAIL_BASE_URL=

# Session security
AUTHKITS_SESSION_TRACKING=1
AUTHKITS_TRUSTED_DEVICES=0
AUTHKITS_DEVICE_TTL=2592000

# MFA
AUTHKITS_MFA_ENFORCED=0
AUTHKITS_MFA_ALLOWED_METHODS=totp,email
AUTHKITS_TOTP_ISSUER=Authkits Example

# Leave blank to run email MFA only.
# For authenticator/TOTP testing, generate a Fernet key (cryptography is a base dependency; [mfa] remains supported):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple rotation keys may be comma-separated, newest first.
AUTHKITS_TOTP_KEYS=

# Licensing
# Keep the real license key in the untracked .env only.
# Leave the path blank until activation; a configured missing file fails checks.
# Activate with --output .authkits/entitlement.jws, then set that path here.
AUTHKITS_LICENSE_KEY=
AUTHKITS_ENTITLEMENT_FILE=
AUTHKITS_ACTIVATION_URL=https://authkits.com/api/v1/licenses/activate
AUTHKITS_ACTIVATION_CONNECT_TIMEOUT=5
AUTHKITS_ACTIVATION_READ_TIMEOUT=10


# Django admin security
# Protect the normal Django admin through Authkits login + fresh MFA.
AUTHKITS_ADMIN_ENABLED=1
AUTHKITS_ADMIN_REQUIRE_MFA=1
AUTHKITS_ADMIN_REQUIRE_VERIFIED_EMAIL=1
AUTHKITS_ADMIN_FRESH_MFA_TTL=300

# Optional API: install the licensed wheel with [api] before enabling.
AUTHKITS_API_ENABLED=0
AUTHKITS_API_CREDENTIAL_TTL=604800
AUTHKITS_API_CREDENTIAL_MAX_ACTIVE=10

# Optional social: install the licensed wheel with [social] before enabling.
# Configure one or both complete credential pairs. No database SocialApp is needed.
# Install [api,social] and enable both flags for headless social OAuth.
AUTHKITS_SOCIAL_ENABLED=0
AUTHKITS_GITHUB_CLIENT_ID=
AUTHKITS_GITHUB_CLIENT_SECRET=
AUTHKITS_GOOGLE_CLIENT_ID=
AUTHKITS_GOOGLE_CLIENT_SECRET=
